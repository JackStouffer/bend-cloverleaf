{
  "openapi": "3.1.0",
  "info": {
    "title": "Cloverleaf API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Whether the web process is up",
        "security": [],
        "responses": {
          "200": {
            "description": "The web process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "4XX": {
            "description": "The request was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/appraisals": {
      "post": {
        "operationId": "createAppraisal",
        "summary": "Request an appraisal. Sending the same key again is safe",
        "security": [
          {
            "dealerKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewAppraisal"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The appraisal was requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appraisal"
                }
              }
            }
          },
          "200": {
            "description": "An appraisal with this key was already requested, so nothing changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appraisal"
                }
              }
            }
          },
          "422": {
            "description": "The request breaks a rule, which error names",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No key, or a key nobody has",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A key for the other kind of route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "4XX": {
            "description": "The request was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "The change could not be saved, so nothing changed and the request can be sent again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/appraisals/{id}": {
      "get": {
        "operationId": "getAppraisal",
        "summary": "Read one of your organization's appraisals",
        "security": [
          {
            "dealerKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The appraisal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appraisal"
                }
              }
            }
          },
          "404": {
            "description": "Your organization has no appraisal with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No key, or a key nobody has",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A key for the other kind of route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "4XX": {
            "description": "The request was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/appraisals/{id}/cancel": {
      "post": {
        "operationId": "cancelAppraisal",
        "summary": "Cancel one of your organization's appraisals. Cancelling one that's already cancelled changes nothing",
        "security": [
          {
            "dealerKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The appraisal, now cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appraisal"
                }
              }
            }
          },
          "404": {
            "description": "Your organization has no appraisal with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The appraisal is underway or completed, so it can't be cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No key, or a key nobody has",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A key for the other kind of route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "4XX": {
            "description": "The request was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "The change could not be saved, so nothing changed and the request can be sent again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations": {
      "post": {
        "operationId": "createOrganization",
        "summary": "Add a dealer organization and issue its API key, which is shown only in this answer",
        "security": [
          {
            "adminKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewOrganization"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The organization was added. Keep apiKey: it can't be read again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationKey"
                }
              }
            }
          },
          "422": {
            "description": "The name breaks a rule, which error names",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No key, or a key nobody has",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A key for the other kind of route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "4XX": {
            "description": "The request was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "The change could not be saved, so nothing changed and the request can be sent again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/key": {
      "post": {
        "operationId": "rotateOrganizationKey",
        "summary": "Issue an organization a new API key, which is shown only in this answer. Its old key stops working, and a revoked organization is active again",
        "security": [
          {
            "adminKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The organization's new key. Keep apiKey: it can't be read again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationKey"
                }
              }
            }
          },
          "404": {
            "description": "No organization has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No key, or a key nobody has",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A key for the other kind of route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "4XX": {
            "description": "The request was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "The change could not be saved, so nothing changed and the request can be sent again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/revoke": {
      "post": {
        "operationId": "revokeOrganizationKey",
        "summary": "Revoke an organization's API key, so it stops working. Its appraisals stay. Revoking again changes nothing",
        "security": [
          {
            "adminKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The organization, now revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          },
          "404": {
            "description": "No organization has this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No key, or a key nobody has",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A key for the other kind of route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "4XX": {
            "description": "The request was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "5XX": {
            "description": "The change could not be saved, so nothing changed and the request can be sent again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "NewAppraisal": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "zip": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/UsState"
          },
          "due": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "address",
          "zip",
          "state",
          "due"
        ],
        "additionalProperties": false
      },
      "UsState": {
        "type": "string",
        "enum": [
          "AL",
          "AR",
          "AZ",
          "CA",
          "CO",
          "CT",
          "DE",
          "FL",
          "GA",
          "IA",
          "ID",
          "IL",
          "IN",
          "KS",
          "KY",
          "LA",
          "MA",
          "MD",
          "ME",
          "MI",
          "MN",
          "MO",
          "MS",
          "MT",
          "NC",
          "ND",
          "NE",
          "NH",
          "NJ",
          "NM",
          "NV",
          "NY",
          "OH",
          "OK",
          "OR",
          "PA",
          "RI",
          "SC",
          "SD",
          "TN",
          "TX",
          "UT",
          "VA",
          "VT",
          "WA",
          "WI",
          "WV",
          "WY"
        ]
      },
      "Appraisal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "zip": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/UsState"
          },
          "due": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AppraisalStatus"
          }
        },
        "required": [
          "id",
          "organization",
          "key",
          "address",
          "zip",
          "state",
          "due",
          "status"
        ],
        "additionalProperties": false
      },
      "AppraisalStatus": {
        "type": "string",
        "enum": [
          "open",
          "underway",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "NewOrganization": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "OrganizationKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "apiKey"
        ],
        "additionalProperties": false
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrganizationStatus"
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ],
        "additionalProperties": false
      },
      "OrganizationStatus": {
        "type": "string",
        "enum": [
          "active",
          "revoked"
        ]
      }
    },
    "securitySchemes": {
      "dealerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A dealer organization's API key, issued when an admin adds the organization. It reaches only that organization's appraisals"
      },
      "adminKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "The admin key, set as CLOVERLEAF_ADMIN_KEY in the web process's environment"
      }
    }
  }
}
